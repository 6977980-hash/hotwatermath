# The whole repo is deployed into wp-content/themes/hotwatermath.
# Block web access to repo-only files (docs, scripts, dev config). data/*.json stays public:
# it is the site's sourced data and is read by the calculators.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(docs|scripts|node_modules|content|inc|parts|templates)(/|$) - [F,L]
RewriteRule ^(CLAUDE|README|README-OWNER)\.md$ - [F,L]
RewriteRule ^(package|package-lock)\.json$ - [F,L]
RewriteRule ^\.(git|editorconfig|gitignore) - [F,L]
</IfModule>
<FilesMatch "\.(md|mjs|csv|lock)$">
	Require all denied
</FilesMatch>
