{
  "name": "hotwatermath-theme",
  "private": true,
  "version": "0.1.0",
  "description": "Dev scripts for the Hot Water Math WordPress theme. Nothing here ships to visitors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate-data": "node scripts/validate-data.mjs",
    "build:data": "node scripts/build-data.mjs",
    "fetch:sources": "node scripts/fetch-sources.mjs",
    "build:og": "node scripts/build-og.mjs",
    "build:brand": "node scripts/build-brand.mjs",
    "check-links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
