          "field": "Gas type (Natural, LP/Propane)",
          "means": "The only gas the unit may burn without a conversion kit from the maker."
        },
        {
          "field": "Voltage and phase",
          "means": "Electric units: the supply the elements need, usually 240 V single phase."
        },
        {
          "field": "Working pressure (psi)",
          "means": "The highest water pressure the tank is built for, usually 150 psi; the relief valve matches it."
        },
        {
          "field": "First hour rating or UEF (EnergyGuide)",
          "means": "How much hot water it delivers in a busy hour and how efficiently. Often on the yellow EnergyGuide label, not the rating plate."
        }
