    "bands": {
      "amberFrom": 0.6,
      "redFrom": 0.9,
      "source": "Hot Water Math editorial assumption: green below 60% of typical life, amber from 60%, red from 90%; \"old\" from 75%, the point where the repair or replace calculator stops paying for big repairs (one set of bands for both tools, audit F-09)",
      "oldFrom": 0.75
    },
    "minimumLifeYears": 5,
    "statusLabels": {
      "ok": "Well within expected life",
      "warn": "Getting older: plan ahead",
      "bad": "Near or past expected life"
    },
    "models": {
      "rheem": {
        "label": "Rheem",
        "scope": "Rheem tank models whose number starts with XG (gas) or XE (electric and heat pump): the Performance, Performance Plus, Performance Platinum, Gladiator and ProTerra lines",
        "patterns": [
          {
            "id": "rheem-x-series",
            "regex": "^X([GE])(\\d{2})([TSM])(\\d{2})([A-Z]{1,2})(\\d{2})U\\d$",
            "example": "XG50T06EC38U1",
            "segments": "X + G (gas) or E (electric) · gallons · T, S or M (tall, short, medium) · warranty years · series letters · input (thousand BTU/h for gas, hundred watts for electric) · U + revision",
            "fields": {
              "fuel": {
                "group": 1,
                "map": {
                  "G": "Natural gas",
                  "E": "Electric"
                }
              },
              "gallons": {
                "group": 2
              },
              "height": {
                "group": 3,
                "map": {
                  "T": "Tall",
                  "S": "Short",
                  "M": "Medium"
                }
              },
              "warrantyYears": {
                "group": 4
              },
              "series": {
                "group": 5
              },
              "input": {
                "group": 6,
                "gasMultiplier": 1000,
                "gasUnit": "BTU/h",
                "electricMultiplier": 100,
                "electricUnit": "W",
                "zeroMeans": "no element rating in the number (120-volt plug-in heat pump)"
              }
            },
            "heatPumpSeriesPrefix": "H",
            "source": "Rheem product names on The Home Depot listings: every XG/XE tank listing in data/cost-ranges.json names the same gallons, height, warranty years and BTU or watt rating that this rule reads from its model number (checked by npm run build:data)",
            "sourceUrl": "https://www.homedepot.com/p/Rheem-Performance-50-Gal-Tall-38-000-BTU-Natural-Gas-Water-Heater-with-6-Year-Warranty-XG50T06EC38U1/326590285",
            "checked": "2026-11-20"
          }
        ]
      },
      "bradford-white": {
        "label": "Bradford White",
        "scope": "Bradford White residential atmospheric vent gas models (model numbers starting RG)",
        "patterns": [
          {
            "id": "bw-rg",
            "regex": "^RG\\d(\\d{2})([A-Z])(6|10)([NX])",
            "example": "RG250T6N",
            "segments": "RG + series digit · gallon size class · profile letter · warranty years (6 or 10) · N (natural gas) or X (propane)",
            "fields": {
              "gallons": {
                "group": 1,
                "sizeClass": true
              },
              "warrantyYears": {
                "group": 3
              },
              "gas": {
                "group": 4,
                "map": {
                  "N": "Natural gas",
                  "X": "Propane"
                }
              }
            },
            "fuel": "Natural gas or propane",
            "quote": "For Propane (LP) models change suffix “N” to “X”. For 10 year models, change suffix from “6” to “10”.",
            "specRows": [
              {
                "model": "RG130T6N",
                "nominalGallons": 30,
                "btuh": 27000
              },
              {
                "model": "RG240T6N",
                "nominalGallons": 40,
                "btuh": 40000
              },
              {
