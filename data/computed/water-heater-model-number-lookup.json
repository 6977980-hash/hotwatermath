      "navien": {
        "label": "Navien",
        "sourceLine": "U.S. CPSC recall notice, Building Intelligence Center (third party)",
        "patterns": [
          {
            "id": "navien-yymdd",
            "regex": "^\\d{4}[A-Z0-9](\\d{2})([1-9XYZ])(0[1-9]|[12]\\d|3[01])",
            "fields": {
              "year": {
                "group": 1,
                "type": "yy"
              },
              "month": {
                "group": 2,
                "type": "letterMonth",
                "letters": "123456789XYZ"
              }
            },
            "validFromYear": 2010
          },
          {
            "id": "navien-dash-yyyymmdd",
            "regex": "^\\d{4}(20[01]\\d)(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])",
            "fields": {
              "year": {
                "group": 1,
                "type": "yyyy"
              },
              "month": {
                "group": 2,
                "type": "mm"
              }
            }
          }
        ]
      }
    },
