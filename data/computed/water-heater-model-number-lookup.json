    "serialBrands": {
      "bradford-white": {
        "label": "Bradford White",
        "sourceLine": "Bradford White",
        "patterns": [
          {
            "id": "bw-letter-year-month",
            "regex": "^([A-HJ-NPSTW-Z])([A-HJ-M])",
            "fields": {
              "year": {
                "group": 1,
                "type": "letterYear",
                "letters": "ABCDEFGHJKLMNPSTWXYZ",
                "cycleStarts": [
                  1964,
                  1984,
                  2004,
                  2024
                ]
              },
              "month": {
                "group": 2,
                "type": "letterMonth",
                "letters": "ABCDEFGHJKLM"
              }
            }
          }
        ]
      },
      "rheem": {
        "label": "Rheem / Ruud",
        "sourceLine": "Rheem/Ruud lookup, InspectApedia (third party), Energy Trust of Oregon",
        "patterns": [
          {
            "id": "rheem-letter-mmyy-plant",
            "regex": "^[A-Z](0[1-9]|1[0-2])(\\d{2})[A-Z]",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2010
          },
          {
            "id": "rheem-prefix-mmyy",
            "regex": "^[A-Z]{2,4}(0[1-9]|1[0-2])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2010
          },
          {
            "id": "rheem-plant-wwyy",
            "regex": "^[A-Z](0[1-9]|[1-4]\\d|5[0-3])(\\d{2})",
            "fields": {
              "week": {
                "group": 1,
                "type": "ww"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            }
          },
          {
            "id": "rheem-mmyy",
            "regex": "^(0[1-9]|1[0-2])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            }
          }
        ]
      },
      "ao-smith": {
        "label": "A. O. Smith",
        "sourceLine": "Energy Trust of Oregon, A. O. Smith serial notice, U.S. CPSC recall notice",
        "patterns": [
          {
            "id": "aos-yyww",
            "regex": "^(\\d{2})(\\d{2})(?:[A-Z]|\\d{9})",
            "fields": {
              "year": {
                "group": 1,
                "type": "yy"
              },
              "week": {
                "group": 2,
                "type": "ww"
              }
            },
            "validFromYear": 2008
          },
          {
            "id": "aos-letter-month-yy",
            "regex": "^[A-Z]([A-HJ-N])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "letterMonth",
                "letters": "ABCDEFGHJKLMN"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2008
          },
          {
            "id": "aos-first-letter-month-yy",
            "regex": "^([A-HJ-N])(\\d{2})[A-Z]",
            "fields": {
              "month": {
                "group": 1,
                "type": "letterMonth",
                "letters": "ABCDEFGHJKLMN"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2008
          }
        ]
      },
      "state": {
        "label": "State",
        "sourceLine": "Energy Trust of Oregon, Building Intelligence Center (third party)",
        "patterns": [
          {
            "id": "state-yyww",
            "regex": "^(\\d{2})(\\d{2})",
            "fields": {
              "year": {
                "group": 1,
                "type": "yy"
              },
              "week": {
                "group": 2,
                "type": "ww"
              }
            },
            "validFromYear": 2008
          },
          {
            "id": "state-letter-month-yy",
            "regex": "^([A-HJ-N])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "letterMonth",
                "letters": "ABCDEFGHJKLMN"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2008
          },
          {
            "id": "state-factory-month-yy",
            "regex": "^[A-Z]([A-HJ-N])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "letterMonth",
                "letters": "ABCDEFGHJKLMN"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2004
          }
        ]
      },
      "american": {
        "label": "American",
        "sourceLine": "U.S. CPSC recall notice",
        "patterns": [
          {
            "id": "american-yyww",
            "regex": "^(\\d{2})(\\d{2})",
            "fields": {
              "year": {
                "group": 1,
                "type": "yy"
              },
              "week": {
                "group": 2,
