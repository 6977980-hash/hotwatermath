      "rows": [
        {
          "brand": "Bradford White",
          "rule": "year letter, then month letter",
          "example": "DF******* → June 1967, 1987, 2007 or 2027 (latest not in the future)"
        },
        {
          "brand": "Rheem / Ruud",
          "rule": "two-digit week, then two-digit year",
          "example": "Q4319***** → week 43 of 2019 (Rheem/Ruud lookup: October 18, 2019)"
        },
        {
          "brand": "",
          "rule": "two-digit month, then two-digit year",
          "example": "0794****** → July 1994"
        },
        {
          "brand": "A. O. Smith",
          "rule": "two-digit year, then two-digit week (2008 and later)",
          "example": "0805A****** → 2008, week 5"
        },
        {
          "brand": "",
          "rule": "month letter, then two-digit year (up to 2008)",
          "example": "*H06****** → August 2006"
        },
        {
          "brand": "State",
          "rule": "two-digit year, then two-digit week (2008 and later)",
          "example": "0904******* → 2009, week 4 (Energy Trust labels this example April 2009, which does not match its own year-week rule; we follow the rule)"
        },
        {
          "brand": "",
          "rule": "month letter, then two-digit year (up to 2008)",
          "example": "C05******* → March 2005"
        },
        {
          "brand": "American",
          "rule": "two-digit year, then two-digit week",
          "example": "9746****** → 1997, week 46"
        },
        {
          "brand": "Navien",
          "rule": "two-digit year, then month letter",
          "example": "7410*18709**** → July 9, 2018 (CPSC example)"
        }
      ],
      "source": "Energy Trust of Oregon, Water Heater Serial Number Decoder (2025); Bradford White, Determine the Age of My Water Heater; Rheem/Ruud official age lookup; U.S. CPSC recall notices (Navien)",
      "sourceUrl": "https://insider.energytrust.org/wp-content/uploads/CPF_Serial_Water_Heater.pdf",
