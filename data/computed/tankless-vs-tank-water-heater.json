  "crossChecks": [
    {
      "id": "doe-hp-payback",
      "label": "Heat pump instead of an electric tank: simple payback",
      "ours": "3.2 years (extra 1,368 ÷ 426 saved a year)",
      "published": "DOE: 5.6 years (Table V.8, 2022 dollars)",
      "diffPct": -42.9,
      "why": "Same order. DOE used 2022 prices and its own equipment cost model; our heat pump listings carry a larger price gap today.",
      "source": "U.S. Department of Energy, Federal Register: Energy conservation standards for consumer water heaters, final rule (89 FR 37778, May 6, 2024)",
      "sourceUrl": "https://www.govinfo.gov/content/pkg/FR-2024-05-06/html/2024-09209.htm"
    },
    {
      "id": "doe-el-op",
      "label": "Electric tank, first-year running cost",
      "ours": "$564",
      "published": "DOE: $340 (2022 dollars, field use)",
      "diffPct": 65.8,
      "why": "DOE models each household’s real use and 2022 prices; we use a typical 55-gallon day and 2025 EIA prices. Electricity cost more in 2025.",
      "source": "U.S. Department of Energy, Federal Register: Energy conservation standards for consumer water heaters, final rule (89 FR 37778, May 6, 2024)",
      "sourceUrl": "https://www.govinfo.gov/content/pkg/FR-2024-05-06/html/2024-09209.htm"
    },
    {
      "id": "doe-hp-op",
      "label": "Heat pump, first-year running cost",
      "ours": "$138",
      "published": "DOE: $171 (2022 dollars)",
      "diffPct": -19.3,
      "why": "Our median UEF comes from today’s ENERGY STAR list, which is higher than DOE’s first heat pump level.",
      "source": "U.S. Department of Energy, Federal Register: Energy conservation standards for consumer water heaters, final rule (89 FR 37778, May 6, 2024)",
      "sourceUrl": "https://www.govinfo.gov/content/pkg/FR-2024-05-06/html/2024-09209.htm"
    },
    {
      "id": "doe-gt-op",
      "label": "Gas tankless, first-year running cost",
      "ours": "$162",
      "published": "DOE: $303 (2023 dollars, baseline gas tankless)",
      "diffPct": -46.6,
      "why": "DOE’s households with tankless units use more hot water than a typical day, and its figure includes electricity for the burner fan and controls, which UEF-based math leaves out.",
      "source": "U.S. Department of Energy, Federal Register: Energy conservation standards for consumer gas-fired instantaneous water heaters, final rule (89 FR 105188, December 26, 2024)",
      "sourceUrl": "https://www.govinfo.gov/content/pkg/FR-2024-12-26/pdf/2024-30369.pdf"
    }
  ],
