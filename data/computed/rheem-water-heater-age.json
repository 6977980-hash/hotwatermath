      "rheem": {
        "label": "Rheem / Ruud",
        "sourceLine": "Rheem/Ruud lookup, InspectApedia (third party), Energy Trust of Oregon",
        "patterns": [
          {
            "id": "rheem-letter-mmyy-plant",
            "regex": "^[A-Z](0[1-9]|1[0-2])(\\d{2})[A-Z]",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2010
          },
          {
            "id": "rheem-prefix-mmyy",
            "regex": "^[A-Z]{2,4}(0[1-9]|1[0-2])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            },
            "validToYear": 2010
          },
          {
            "id": "rheem-plant-wwyy",
            "regex": "^[A-Z](0[1-9]|[1-4]\\d|5[0-3])(\\d{2})",
            "fields": {
              "week": {
                "group": 1,
                "type": "ww"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            }
          },
          {
            "id": "rheem-mmyy",
            "regex": "^(0[1-9]|1[0-2])(\\d{2})",
            "fields": {
              "month": {
                "group": 1,
                "type": "mm"
              },
              "year": {
                "group": 2,
                "type": "yy"
              }
            }
          }
        ]
      },
