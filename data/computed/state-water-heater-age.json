            "regex": "^([A-HJ-NPSTW-Z])([A-HJ-M])",
            "fields": {
              "year": {
                "group": 1,
                "type": "letterYear",
                "letters": "ABCDEFGHJKLMNPSTWXYZ",
                "cycleStarts": [
