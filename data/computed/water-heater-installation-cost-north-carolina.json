    "notes": [
      {
        "id": "nc-exemption",
        "heading": "North Carolina law can waive the permit for a like-for-like swap",
        "text": "North Carolina's General Assembly exempted one- and two-family homes from a plumbing permit for a replacement water heater, but only when a licensed plumber does the job, examines it and leak-tests the gas piping, and the new unit uses no more energy and keeps the same fuel, location, capacity and venting. Any change, such as gas to heat pump, brings the permit back. Counties such as Wake publish the same rule.",
        "source": "North Carolina General Assembly, Session Law 2013-160",
        "sourceUrl": "https://library.ncleg.net/EnactedLegislation/SessionLaws/HTML/2013-2014/SL2013-160.html",
        "quote": "a permit shall not be required for the connection of a water heater that is being replaced, provided that the work is performed by a person licensed under G.S. 87-21, who personally examines the work at completion and ensures that a leak test has been performed on the gas piping",
        "checked": "2026-11-14"
      }
    ],
